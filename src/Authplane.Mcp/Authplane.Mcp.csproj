<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Authplane.Mcp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Authplane Team</Authors>
    <Description>Authplane adapter for MCP ASP.NET Core transports.</Description>
    <PackageTags>oauth;jwt;mcp;aspnetcore;authplane</PackageTags>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RepositoryUrl>https://github.com/AuthPlane/cs-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/AuthPlane/cs-sdk/tree/develop/src/Authplane.Mcp</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Title>Authplane MCP adapter for .NET</Title>
    <Copyright>Copyright © Authplane Team</Copyright>
    <PackageReleaseNotes>https://github.com/AuthPlane/cs-sdk/blob/develop/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Shared brand isotype at the repo root, packed into every publishable
         package so nuget.org renders the Authplane mark instead of the default
         placeholder. Kept as a single source of truth rather than a per-project
         copy. -->
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP C# SDK - HTTP server and hosting extensions -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.0.0" />

    <!-- Core Authplane SDK project (local sibling repo).
         Adjust/remove this when Authplane is published as a NuGet package. -->
    <ProjectReference Include="..\Authplane\Authplane.csproj" />
  </ItemGroup>

</Project>

