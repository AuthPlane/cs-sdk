# Optional. run.sh defaults are correct for the authserver demo:
#   ISSUER_URL=http://localhost:9000
#   RESOURCE_URL=http://localhost:8080/mcp
#   DEV_MODE=true
# CLIENT_ID / CLIENT_SECRET are picked up automatically from
# /tmp/authserver-demo.client-id and /tmp/authserver-demo.key written by
