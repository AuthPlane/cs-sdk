<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <!-- The demo is an executable, not a library. Excluding it from
         `dotnet pack` keeps the produced .nupkg set scoped to the
         shippable libraries (Authplane.Sdk, Authplane.Mcp). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Authplane.Mcp\Authplane.Mcp.csproj" />
  </ItemGroup>

</Project>
